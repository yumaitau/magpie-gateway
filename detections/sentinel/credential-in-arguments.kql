// A secrets recogniser hit. Detail.hits[].kind is "secret".
// The preview is the replacement, not the secret, unless payload capture is on.
// Leave capture off.
MagpieAudit_CL
| where TimeGenerated > ago(1d)
| mv-expand hit = Detail.hits
| where hit.kind == "secret"
| project TimeGenerated, Actor, AgentId, Tool, Decision, Reason, Kind = hit.kind
